# Secrets and local config — never commit
.env
.env.*
!.env.example
.netrc
*.netrc
*.pem
*.key
*.p12
*.kdbx
secrets/

# Build outputs and large artifacts
out/
dist/
build/
*.iso
*.qcow2
*.raw
*.tar.gz
*.log

# Raw dumps may contain serials, MACs, session data
*_dump_*/

# Python / Node
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
